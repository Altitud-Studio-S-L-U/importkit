{
  "name": "@altitud-studio/importkit",
  "version": "0.2.0",
  "description": "Validate and resume bounded file imports for Node.js. Stream records, report issues, and recover with stable IDs.",
  "type": "module",
  "license": "MIT",
  "author": "Altitud Studio SLU (https://altitudstudio.ad)",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/Altitud-Studio-S-L-U/importkit.git" },
  "bugs": { "url": "https://github.com/Altitud-Studio-S-L-U/importkit/issues" },
  "homepage": "https://github.com/Altitud-Studio-S-L-U/importkit#readme",
  "keywords": ["import", "csv", "jsonl", "streaming", "checkpoint", "resumable", "typescript", "nodejs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node examples/validation.mjs && node examples/recovery.mjs",
    "demo:validation": "npm run build && node examples/validation.mjs",
    "demo:recovery": "npm run build && node examples/recovery.mjs",
    "benchmark": "npm run build && node benchmarks/import.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": { "csv-parse": "7.0.3" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2" }
}
