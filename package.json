{
  "name": "@altitud-studio/importkit",
  "version": "0.3.0",
  "description": "Resumable, validated CSV and JSON Lines imports for Node.js backends.",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "author": "Altitud Studio SLU (https://altitudstudio.ad)",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/Altitud-Studio-S-L-U/importkit.git" },
  "bugs": { "url": "https://github.com/Altitud-Studio-S-L-U/importkit/issues" },
  "homepage": "https://github.com/Altitud-Studio-S-L-U/importkit#readme",
  "keywords": ["import", "csv", "jsonl", "streaming", "checkpoint", "resumable", "typescript", "nodejs"],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node examples/validation.mjs && node examples/recovery.mjs && node examples/transactional.mjs",
    "demo:validation": "npm run build && node examples/validation.mjs",
    "demo:recovery": "npm run build && node examples/recovery.mjs",
    "demo:transactional": "npm run build && node examples/transactional.mjs",
    "benchmark": "npm run build && node benchmarks/import.mjs",
    "benchmark:large": "npm run build && node benchmarks/large-files.mjs",
    "check:docs": "npm run build && node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && node scripts/check-docs.mjs"
  },
  "dependencies": { "csv-parse": "7.0.3" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2", "zod": "4.6.7" }
}
